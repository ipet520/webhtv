<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="?attr/webhtvColorPlayerScrim" />
                    <stroke android:width="1dp" android:color="?attr/webhtvColorPlayerControlMuted" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#B3000000" />
                    <stroke android:width="2dp" android:color="?attr/webhtvColorPlayerControlActive" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#B3000000" />
                    <stroke android:width="2dp" android:color="?attr/webhtvColorPlayerControlActive" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#B3000000" />
                    <stroke android:width="2dp" android:color="?attr/webhtvColorPlayerControlActive" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#B3000000" />
                    <stroke android:width="2dp" android:color="?attr/webhtvColorPlayerControlActive" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="?attr/webhtvColorPlayerScrim" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/webhtvColorPlayerControlMuted" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
