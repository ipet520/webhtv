<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/webhtv_color_focus">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="?attr/colorSurfaceContainerHighest" />
                    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="?attr/colorPrimaryContainer" />
                    <stroke android:width="2dp" android:color="@color/webhtv_color_focus" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="?attr/colorPrimaryContainer" />
                    <stroke android:width="2dp" android:color="@color/webhtv_color_focus" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="?attr/colorSecondaryContainer" />
                    <stroke android:width="1dp" android:color="?attr/colorPrimary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="?attr/colorSurfaceContainerHighest" />
                    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
