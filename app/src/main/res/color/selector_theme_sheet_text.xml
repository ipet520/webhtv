<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled must win even when a TV view remains focused. -->
    <item android:color="?attr/colorOnSurfaceVariant" android:state_enabled="false" />
    <item android:color="?attr/colorOnPrimary" android:state_pressed="true" />
    <item android:color="?attr/colorOnPrimary" android:state_focused="true" />
    <item android:color="?attr/colorOnPrimaryContainer" android:state_activated="true" />
    <item android:color="?attr/colorOnPrimaryContainer" android:state_selected="true" />
    <item android:color="?attr/colorOnSurface" />
</selector>
